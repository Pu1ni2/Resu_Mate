# Python
__pycache__/
*.pyc
*.pyo
venv/
.venv/
.coverage
htmlcov/
# Settings with secrets: .env, and its variants (.env.local, .env.production),
# which only .env was. The example, with no secrets, is kept.
.env
.env.*
!.env.example
# Local databases, which hold candidates' data.
*.db
*.sqlite
*.sqlite3
*.log
# Private keys.
*.pem
# Left by older versions: the résumé search index (ChromaDB) and the agents'
# memory file are gone, and nothing reads the interview files, superseded by
# the interviews table. They held candidate emails, names and full interview
# transcripts, so they must never be committed.
chroma_db/
interviews_data.json
interview_results.json
agent_memory.json
# Uploaded résumés are candidates' personal data. "uploads/*.pdf" only matched a
# top-level folder, so backend/uploads/ was never ignored. The folder itself is
# kept by its .gitkeep.
**/uploads/*
!**/uploads/.gitkeep
# Database backups (backend/scripts/backup_db.py) hold candidates' personal
# data. The repository is public: they must never be committed.
backups/
*.dump

# Node
node_modules/
dist/
.vite/

# IDE
.vscode/
.idea/
*.swp
.DS_Store
