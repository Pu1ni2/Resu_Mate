# Python
__pycache__/
*.pyc
*.pyo
venv/
.env
*.db
chroma_db/
# Local interview data — these are runtime artefacts of an older, pre-Postgres
# implementation, superseded by the interviews table. No code reads them, and
# they accumulate candidate emails, names and full interview transcripts, so
# they must never be committed.
interviews_data.json
interview_results.json
agent_memory.json
# Uploaded résumés are candidates' personal data. "uploads/*.pdf" only matched a
# top-level folder, so backend/uploads/ was never ignored. The folder itself is
# kept by its .gitkeep.
**/uploads/*
!**/uploads/.gitkeep
# Database backups (backend/scripts/backup_db.py) hold candidates' personal
# data. The repository is public: they must never be committed.
backups/
*.dump

# Node
node_modules/
dist/
.vite/

# IDE
.vscode/
.idea/
*.swp
.DS_Store
