# Copy to backend/.env for local development. Every setting the backend and the
# interview worker read is listed here; the values are local-dev defaults.

# ── Security ────────────────────────────────────────────────────────────────
# Signs every login token. The app refuses to start without a strong one unless
# DEBUG is true. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=
# true for local development only: it relaxes the SECRET_KEY check and, when
# e-mail can't be sent, returns candidate sign-in codes in the API response.
# Must be false in production.
DEBUG=true
# Shared by the backend and the interview worker (X-Agent-Token). Any long
# random string; set the same value on both.
AGENT_SHARED_SECRET=

# ── AI ──────────────────────────────────────────────────────────────────────
OPENAI_API_KEY=sk-your-key
OPENAI_MODEL=gpt-4o

# ── Search & APIs ───────────────────────────────────────────────────────────
TAVILY_API_KEY=tvly-your-key
GITHUB_TOKEN=ghp_your-token
CALENDLY_TOKEN=your-calendly-token

# Candidate sourcer (Hiring -> Find candidates)
# Uses OPENAI_API_KEY, TAVILY_API_KEY (web profiles) and GITHUB_TOKEN (GitHub
# search: without a token GitHub allows only 60 requests an hour).
# SOURCER_MODEL judges every profile, so a run makes many calls: a faster,
# cheaper model than OPENAI_MODEL is a good choice. Blank = OPENAI_MODEL.
SOURCER_MODEL=
# Optional, in dollars per million tokens, for the live "cost so far" figure.
# Leave blank to show tokens instead of a guessed price.
SOURCER_PRICE_IN_PER_1M=
SOURCER_PRICE_OUT_PER_1M=
# How many people one run reads from each source.
SOURCER_MAX_GITHUB=300
SOURCER_MAX_WEB=30

# ── Database ────────────────────────────────────────────────────────────────
# SQLite for local, PostgreSQL for production
# Local: DATABASE_URL=sqlite+aiosqlite:///./resumate.db
# Render: DATABASE_URL=postgresql://user:pass@host:5432/dbname
DATABASE_URL=sqlite+aiosqlite:///./resumate.db
# Where resume embeddings are kept.
CHROMA_DIR=chroma_db
CHROMA_COLLECTION=resumes

# ── Server ──────────────────────────────────────────────────────────────────
# Added to the always-allowed local and Render origins.
CORS_ORIGINS=http://localhost:3006,http://localhost:3001,http://localhost:3000,http://localhost:5173
# Where e-mailed links point (interview invitations). Must be reachable by the
# recipient, so production sets the deployed frontend URL.
FRONTEND_URL=http://localhost:3006

# ── E-mail (SendGrid) ───────────────────────────────────────────────────────
# Without a key, e-mails are printed to the console instead of sent.
SENDGRID_API_KEY=
FROM_EMAIL=noreply@resumate.ai

# ── Live interviews (LiveKit + Simli avatar) ────────────────────────────────
# Avatar interviews need the interview worker (interview_agent.py) running.
# Leave this false until it is: every interview then runs voice-only.
AVATAR_INTERVIEWS=false
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
SIMLI_API_KEY=
SIMLI_FACE_ID=tmp9i8bbq7c

# ── Conversational interviews (OpenAI Realtime, audio only) ─────────────────
# Model and voice are checked against an allow-list in app/api/realtime.py.
REALTIME_MODEL=gpt-realtime-2
REALTIME_VOICE=marin
REALTIME_MAX_TOTAL_MINUTES=8

# ── Resume file storage (optional, S3-compatible: AWS S3, Cloudflare R2, B2) ─
# With S3_BUCKET blank, originals are parsed and then discarded.
S3_BUCKET=
S3_ENDPOINT=
S3_REGION=us-east-1
S3_ACCESS_KEY=
S3_SECRET_KEY=

# ── Interview worker only (python interview_agent.py start) ─────────────────
# The worker also reads OPENAI_API_KEY, LIVEKIT_*, SIMLI_* and AGENT_SHARED_SECRET.
BACKEND_URL=http://localhost:8006
OPENAI_VOICE=alloy
