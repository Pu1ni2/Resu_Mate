# AI
OPENAI_API_KEY=sk-your-key
OPENAI_MODEL=gpt-4o

# Search & APIs
TAVILY_API_KEY=tvly-your-key
GITHUB_TOKEN=ghp_your-token
CALENDLY_TOKEN=your-calendly-token

# Candidate sourcer (Hiring -> Find candidates)
# Uses OPENAI_API_KEY, TAVILY_API_KEY (web profiles) and GITHUB_TOKEN (GitHub
# search: without a token GitHub allows only 60 requests an hour).
# SOURCER_MODEL judges every profile, so a run makes many calls: a faster,
# cheaper model than OPENAI_MODEL is a good choice. Blank = OPENAI_MODEL.
SOURCER_MODEL=
# Optional, in dollars per million tokens, for the live "cost so far" figure.
# Leave blank to show tokens instead of a guessed price.
SOURCER_PRICE_IN_PER_1M=
SOURCER_PRICE_OUT_PER_1M=
# How many people one run reads from each source.
SOURCER_MAX_GITHUB=300
SOURCER_MAX_WEB=30

# Database (SQLite for local, PostgreSQL for production)
# Local: DATABASE_URL=sqlite+aiosqlite:///./resumate.db
# Render: DATABASE_URL=postgresql://user:pass@host:5432/dbname
DATABASE_URL=sqlite+aiosqlite:///./resumate.db

# Server
CORS_ORIGINS=http://localhost:3001,http://localhost:3000,http://localhost:5173
