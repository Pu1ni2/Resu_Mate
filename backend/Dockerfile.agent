# Python 3.12, as the server runs on (runtime.txt): requirements-agent.txt is
# locked for 3.12, and some of its packages (av, for one) need it.
FROM python:3.12-slim

WORKDIR /app

# Install dependencies
COPY requirements-agent.txt .
RUN pip install --no-cache-dir -r requirements-agent.txt

# Copy agent
COPY interview_agent.py .

# A user of its own, not root: the worker needs no more, so a flaw in it, or
# in a package it uses, gets no more either.
RUN useradd --create-home --uid 10001 worker
USER worker

# LiveKit agent start command
CMD ["python", "interview_agent.py", "start"]
